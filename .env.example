APP_NAME=AttApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# MySQL / TiDB Cloud. For TiDB (or any TLS-only host) set MYSQL_ATTR_SSL_CA to your CA bundle.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attapp
DB_USERNAME=root
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
